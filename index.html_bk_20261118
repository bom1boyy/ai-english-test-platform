const TOPICS = [
  'what they did last weekend — dig into one specific moment',
  'food they have been craving lately, and the best or worst thing they ate this week',
  'their commute, and the weirdest thing they have seen on the subway or bus',
  'a show, movie or YouTube video they watched recently',
  'work: one small win and one small annoyance from this week',
  'what they would do if they won a billion won tomorrow',
  'the best trip they have taken, and a dream destination',
