let C = null; // current call state

async function startCall(){
  if(!S.apiKey){ toast('먼저 ⚙️ 설정에서 무료 API 키를 넣어주세요'); go('settings'); return; }
  if(!navigator.mediaDevices?.getUserMedia){ toast('이 브라우저는 마이크를 지원하지 않아요 (https 주소로 열어주세요)'); return; }
  const P = partner();
  C = { ws:null, ctx:null, stream:null, node:null, src:null, inAn:null, outAn:null, sources:new Set(), nextTime:0,
        ready:false, closing:false, muted:false, handle:null, reconnects:0, greeted:false,
        transcript:[], start:0, timerId:0, wrapSent:false, raf:0, wake:null, durSec:S.sel.dur*60, capsOn:S.sel.caps==='1' };
  $('cName').textContent = P.name; $('cSub').textContent = P.tag; $('cTimer').textContent='00:00';
  $('caps').innerHTML=''; $('caps').classList.toggle('on', C.capsOn); $('capBtn').classList.toggle('on', C.capsOn);
  $('muteBtn').classList.remove('on'); setState('idle','전화 거는 중… 📞');
  go('call');
  try{
    C.ctx = new (window.AudioContext||window.webkitAudioContext)();
    await C.ctx.resume();
    C.stream = await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true, noiseSuppression:true, autoGainControl:true, channelCount:1}});
    await setupMic();
    C.outAn = C.ctx.createAnalyser(); C.outAn.fftSize = 512; C.outAn.connect(C.ctx.destination);
    try{ C.wake = await navigator.wakeLock?.request('screen'); }catch(e){}
    openSocket(null);
    animate();
  }catch(e){
    console.error(e); toast('마이크 권한이 필요해요: '+(e.message||e)); cleanup(); C = null; go('home');
  }
}

async function setupMic(){
  const code = `
  class Cap extends AudioWorkletProcessor{
    constructor(){ super(); this.ratio = sampleRate/16000; this.pos=0; this.sum=0; this.cnt=0; this.out=new Int16Array(1600); this.n=0; }
    process(inputs){
      const ch = inputs[0] && inputs[0][0]; if(!ch) return true;
      for(let i=0;i<ch.length;i++){
        this.sum += ch[i]; this.cnt++; this.pos += 1;
        if(this.pos >= this.ratio){
          this.pos -= this.ratio;
          let v = this.sum/this.cnt; this.sum=0; this.cnt=0;
          v = Math.max(-1, Math.min(1, v));
          this.out[this.n++] = v<0 ? v*0x8000 : v*0x7fff;
          if(this.n === this.out.length){ this.port.postMessage(this.out.buffer.slice(0)); this.n=0; }
        }
      }
      return true;
    }
  }
  registerProcessor('ringo-cap', Cap);`;
  C.src = C.ctx.createMediaStreamSource(C.stream);
  C.inAn = C.ctx.createAnalyser(); C.inAn.fftSize = 512;
  C.src.connect(C.inAn);
  const g = C.ctx.createGain(); g.gain.value = 0; g.connect(C.ctx.destination); // node must be pulled
  const send = buf => {
    if(!C || !C.ready || C.muted || C.ws?.readyState!==1) return;
    C.ws.send(JSON.stringify({realtimeInput:{audio:{data:b64(buf), mimeType:'audio/pcm;rate=16000'}}}));
  };
  try{
    if(!C.ctx.audioWorklet) throw new Error('no worklet');
    const url = URL.createObjectURL(new Blob([code], {type:'application/javascript'}));
    await C.ctx.audioWorklet.addModule(url);
    C.node = new AudioWorkletNode(C.ctx, 'ringo-cap');
    C.node.port.onmessage = e => send(e.data);
  }catch(err){
    // fallback (e.g. opened as a local file): ScriptProcessor + same downsampling
    console.warn('worklet unavailable, using ScriptProcessor', err);
    const ratio = C.ctx.sampleRate/16000; let pos=0, sum=0, cnt=0, n=0, out=new Int16Array(1600);
    C.node = C.ctx.createScriptProcessor(4096, 1, 1);
    C.node.onaudioprocess = e => {
      const ch = e.inputBuffer.getChannelData(0);
      for(let i=0;i<ch.length;i++){
        sum += ch[i]; cnt++; pos += 1;
        if(pos >= ratio){ pos -= ratio; let v = Math.max(-1, Math.min(1, sum/cnt)); sum=0; cnt=0;
          out[n++] = v<0 ? v*0x8000 : v*0x7fff;
          if(n === out.length){ send(out.buffer.slice(0)); n=0; } }
      }
    };
  }
  C.src.connect(C.node); C.node.connect(g);
}

function openSocket(handle){
  const v = VAD[S.vad] || VAD.normal;
  const ws = new WebSocket(`${WS_URL}?key=${encodeURIComponent(S.apiKey)}`);
  ws.binaryType = 'arraybuffer';
  C.ws = ws; C.ready = false;
  ws.onopen = () => {
    ws.send(JSON.stringify({setup:{
      model: 'models/' + S.liveModel,
      generationConfig: {
        responseModalities: ['AUDIO'],
        speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: partner().voice } } },
        temperature: 1.0,
      },
      systemInstruction: { parts: [{ text: buildSystem() }] },
      realtimeInputConfig: { automaticActivityDetection: {
        startOfSpeechSensitivity: 'START_SENSITIVITY_HIGH',
        endOfSpeechSensitivity: v.end, prefixPaddingMs: 40, silenceDurationMs: v.silence } },
      inputAudioTranscription: {}, outputAudioTranscription: {},
      contextWindowCompression: { slidingWindow: {} },
      sessionResumption: handle ? { handle } : {},
    }}));
  };
  ws.onmessage = async ev => {
    let txt = typeof ev.data === 'string' ? ev.data : new TextDecoder().decode(ev.data);
    let m; try{ m = JSON.parse(txt); }catch(e){ return; }
    onServer(m);
  };
  ws.onerror = e => console.warn('ws error', e);
  ws.onclose = e => {
    if(!C || ws !== C.ws) return;
    if(C.closing) return;
    console.warn('ws closed', e.code, e.reason);
    if(C.handle && C.reconnects < 3 && C.greeted){ C.reconnects++; setState('idle','잠깐 신호가 끊겼어요… 다시 연결 중'); openSocket(C.handle); return; }
    const reason = e.reason || `연결 종료 (code ${e.code})`;
    toast('연결이 끊겼어요: ' + reason, 6000);
    hangUp(true);
  };
}

function reconnect(){
  if(!C || !C.handle) return;
  const old = C.ws; C.ws = null;
  try{ old.onclose = null; old.close(); }catch(e){}
  openSocket(C.handle);
}

function onServer(m){
  if(!C) return;
  if(m.setupComplete){
    C.ready = true;
    if(!C.greeted){
      C.greeted = true; C.start = Date.now(); C.timerId = setInterval(tick, 500);
      $('cSub').textContent = '통화 중'; setState('speak','');
      sendText('(App note: the call just connected. Say hello now.)');
    } else { setState('listen','다시 연결됐어요'); }
    return;
  }
  if(m.sessionResumptionUpdate){ if(m.sessionResumptionUpdate.resumable && m.sessionResumptionUpdate.newHandle) C.handle = m.sessionResumptionUpdate.newHandle; }
  if(m.goAway){ reconnect(); return; }
  const sc = m.serverContent; if(!sc) return;
  if(sc.interrupted){ flushAudio(); }
  if(sc.modelTurn?.parts){
    for(const p of sc.modelTurn.parts){
      if(p.inlineData?.data && (p.inlineData.mimeType||'').startsWith('audio')) playPCM(p.inlineData.data, p.inlineData.mimeType);
    }
  }
  if(sc.inputTranscription?.text) addCap('user', sc.inputTranscription.text);
  if(sc.outputTranscription?.text) addCap('ai', sc.outputTranscription.text);
}

function sendText(t){ if(C?.ws?.readyState===1) C.ws.send(JSON.stringify({realtimeInput:{text:t}})); }

/* ---- audio out ---- */
function playPCM(data, mime){
  const rate = +(/rate=(\d+)/.exec(mime||'')?.[1] || 24000);
  const bin = atob(data); const len = bin.length >> 1;
  const f = new Float32Array(len);
  for(let i=0;i<len;i++){ let s = bin.charCodeAt(2*i) | (bin.charCodeAt(2*i+1)<<8); if(s>=0x8000) s -= 0x10000; f[i] = s/32768; }
  const buf = C.ctx.createBuffer(1, len, rate); buf.copyToChannel(f, 0);
  const src = C.ctx.createBufferSource(); src.buffer = buf; src.connect(C.outAn);
  const t = Math.max(C.ctx.currentTime + 0.03, C.nextTime);
  src.start(t); C.nextTime = t + buf.duration;
  C.sources.add(src); src.onended = () => C?.sources.delete(src);
}
function flushAudio(){ if(!C) return; C.sources.forEach(s=>{ try{s.stop();}catch(e){} }); C.sources.clear(); C.nextTime = 0; }
function aiSpeaking(){ return C && C.nextTime > C.ctx.currentTime + 0.01; }

/* ---- captions/transcript ---- */
function addCap(role, text){
  const T = C.transcript; let last = T[T.length-1];
  if(!last || last.role !== role){ last = {role, text:''}; T.push(last); }
  last.text += text;
  if(C.capsOn) renderCaps();
}
function renderCaps(){
  const P = partner(); const me = isCouple() ? '우리' : learners()[0].name;
  $('caps').innerHTML = C.transcript.slice(-8).map(t=>`<p class="${t.role==='user'?'u':'a'}"><b>${t.role==='user'?esc(me):esc(P.name)}:</b> ${esc(t.text.trim())}</p>`).join('');
  $('caps').scrollTop = 1e9;
}
function toggleCaps(){ C.capsOn = !C.capsOn; $('caps').classList.toggle('on', C.capsOn); $('capBtn').classList.toggle('on', C.capsOn); if(C.capsOn) renderCaps(); }

/* ---- controls ---- */
function toggleMute(){
  C.muted = !C.muted; $('muteBtn').classList.toggle('on', C.muted);
  if(C.muted && C.ws?.readyState===1) C.ws.send(JSON.stringify({realtimeInput:{audioStreamEnd:true}}));
  toast(C.muted ? '음소거 🔇' : '음소거 해제 🎙️', 1200);
}
function sos(){ sendText('(App note: the learner pressed the "I\'m stuck" button. In a natural, friendly way, help them out: suggest one or two simple phrases they could say right now, then hand the turn back to them.)'); toast('도움 요청했어요 🆘', 1200); }
function slower(){ sendText('(App note: the learner asked you to speak a bit slower and with simpler words for a while. Do it naturally, without mentioning it much.)'); toast('천천히 말해달라고 했어요 🐢', 1200); }

function setState(kind, text){ const o=$('orb'); o.className = 'orb ' + (kind==='speak'?'':kind); if(text!=null) $('cState').textContent = text; }

function tick(){
  if(!C) return;
  const s = Math.floor((Date.now()-C.start)/1000);
  $('cTimer').textContent = `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')} / ${S.sel.dur}:00`;
  if(!C.wrapSent && s >= C.durSec - 40){ C.wrapSent = true; sendText('(App note: about 40 seconds of call time left. Start wrapping up naturally and say goodbye within your next turn or two — maybe mention something to talk about next time.)'); }
  if(s >= C.durSec + 30 && !aiSpeaking()) hangUp();
}

function animate(){
  const a = new Uint8Array(256);
  const loop = () => {
    if(!C) return;
    let lvl = 0;
    if(aiSpeaking() && C.outAn){ C.outAn.getByteTimeDomainData(a); lvl = rms(a); if(C.ready) setState('speak', '말하는 중…'); }
    else if(C.inAn && C.ready){ C.inAn.getByteTimeDomainData(a); lvl = C.muted ? 0 : rms(a); setState('listen', C.muted ? '음소거됨' : '듣고 있어요 — 편하게 말하세요'); }
    $('orb').style.transform = `scale(${1 + Math.min(lvl*4, .45)})`;
    C.raf = requestAnimationFrame(loop);
  };
  loop();
}
function rms(a){ let s=0; for(let i=0;i<a.length;i++){ const v=(a[i]-128)/128; s+=v*v; } return Math.sqrt(s/a.length); }

function cleanup(){
  if(!C) return;
  C.closing = true;
  clearInterval(C.timerId); cancelAnimationFrame(C.raf);
  try{ C.ws && C.ws.close(); }catch(e){}
  flushAudio();
  try{ C.stream?.getTracks().forEach(t=>t.stop()); }catch(e){}
  try{ C.ctx?.close(); }catch(e){}
  try{ C.wake?.release(); }catch(e){}
}

function hangUp(failed){
  if(!C || C.closing) return;
  const call = C; cleanup(); C = null;
  const secs = call.start ? Math.floor((Date.now()-call.start)/1000) : 0;
  const userChars = call.transcript.filter(t=>t.role==='user').reduce((n,t)=>n+t.text.trim().length, 0);
  if(secs < 20 || userChars < 15){ if(!failed) toast('통화가 너무 짧아서 리포트는 건너뛸게요'); go('home'); return; }
  const P = partner();
  const rec = { id: Date.now().toString(36), day: dayKey(), ts: Date.now(), profileId: S.sel.profile, lang: S.lang,
    partnerId: P.id, partnerName: P.name, mode: S.sel.mode,
    topic: S.sel.mode==='topic' ? todayTopic() : S.sel.mode==='role' ? ROLEPLAYS[S.sel.role]?.ko : '자유 수다',
    secs, transcript: call.transcript.map(t=>({role:t.role, text:t.text.trim()})), report:null };
  S.history.push(rec); if(S.history.length > 80) S.history = S.history.slice(-80); save();
  showReport(rec, true);
}

/* =========================================================
   통화 후 피드백 리포트
   ========================================================= */
async function makeReport(rec){
  const L = LANGS[rec.lang] || LANGS.en;
  const names = rec.profileId==='both' ? S.profiles.map(p=>p.name).join(' & ') : (S.profiles.find(p=>p.id===rec.profileId)?.name || 'learner');
  const level = rec.profileId==='both' ? 'mixed' : (LEVELS[S.profiles.find(p=>p.id===rec.profileId)?.level]?.ko || '중급');
  const tx = rec.transcript.map(t=>`${t.role==='user'?'LEARNER':rec.partnerName.toUpperCase()}: ${t.text}`).join('\n');
  const prompt = `You are a warm, sharp ${L.name} coach for Korean learners. Below is a speech-to-text transcript of a casual phone call between the learner(s) "${names}" (level: ${level}) and a native-speaker friend "${rec.partnerName}". The transcript may contain speech-recognition glitches — ignore errors that are obviously transcription artifacts, focus on real language issues.

TRANSCRIPT:
${tx}

Return ONLY JSON with this shape:
{
 "summary_ko": "2–3 sentence warm summary in Korean of what they talked about and how they did",
 "good_ko": ["2–3 specific things they did well, in Korean"],
 "corrections": [{"said":"what the learner actually said (short)","better":"how a native would casually say it in ${L.name}","why_ko":"short Korean explanation"}],
 "expressions": [{"en":"natural ${L.name} phrase worth stealing (from the call, or what they were trying to say)","ko":"Korean meaning","example":"short example sentence"}],
 "mission_ko": "one small, fun mission for the next call, in Korean",
 "fun_ko": "one witty, friendly one-liner comment about this call in Korean",
 "memory": "1–2 short English sentences of personal facts/plans/stories the learner shared that ${rec.partnerName} should remember next call",
 "scores": {"fluency":1-5,"vocabulary":1-5,"grammar":1-5,"confidence":1-5}
}
Rules: corrections max 6, pick the most useful (not nitpicks); expressions 3–5; be encouraging but honest.`;
  const tryModel = async model => {
    const r = await fetch(`${REST}${model}:generateContent`, { method:'POST',
      headers:{'Content-Type':'application/json','x-goog-api-key':S.apiKey},
      body: JSON.stringify({contents:[{role:'user', parts:[{text:prompt}]}], generationConfig:{responseMimeType:'application/json', temperature:0.6}})});
    if(!r.ok) throw new Error(`${r.status} ${(await r.text()).slice(0,200)}`);
    const j = await r.json();
    const text = j.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('') || '';
    return JSON.parse(text.replace(/^```json\s*|```$/g,''));
  };
  try{ return await tryModel(S.textModel); }
  catch(e){ console.warn(e); if(S.textModel!=='gemini-2.5-flash') return await tryModel('gemini-2.5-flash'); throw e; }
}

async function showReport(rec, generate){
  go('report');
  const body = $('reportBody');
  if(generate || !rec.report){
    body.innerHTML = `<div class="loading"><div class="spin"></div>${esc(rec.partnerName)}랑 나눈 대화를 정리하는 중…</div>`;
    try{
      const rep = await makeReport(rec);
      rep.expressions = rep.expressions || []; rep.corrections = rep.corrections || [];
      rec.report = rep; const i = S.history.findIndex(h=>h.id===rec.id); if(i>=0) S.history[i] = rec; save();
    }catch(e){
      body.innerHTML = `<div class="card"><b>리포트를 만들지 못했어요</b><p class="note">${esc(e.message)}</p><button class="btn" onclick='retryReport("${rec.id}")'>다시 시도</button></div>` + txBlock(rec, true);
      return;
    }
  }
  const r = rec.report, sc = r.scores || {};
  const m = Math.floor(rec.secs/60), s = rec.secs%60;
  body.innerHTML = `
    <div class="card">
      <div class="h">${esc(rec.day)} · ${esc(rec.partnerName)} · ${m}분 ${s}초 · ${esc(rec.topic||'')}</div>
      <div style="font-size:17px;font-weight:700;line-height:1.45;margin-bottom:8px">${esc(r.fun_ko||'')}</div>
      <div class="topic">${esc(r.summary_ko||'')}</div>
    </div>
    <div class="card"><div class="score">
      ${[['fluency','유창성'],['vocabulary','어휘'],['grammar','문법'],['confidence','자신감']].map(([k,l])=>`<div><b>${sc[k]??'-'}</b><small>${l}</small></div>`).join('')}
    </div></div>
    ${r.good_ko?.length ? `<div class="card"><div class="h">👏 잘한 점</div><ul class="k">${r.good_ko.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`:''}
    ${r.corrections.length ? `<div class="card"><div class="h">✏️ 이렇게 말하면 더 자연스러워요</div>${r.corrections.map(c=>`
      <div class="corr"><div class="said">${esc(c.said)}</div><div class="better">→ ${esc(c.better)}</div><div class="why">${esc(c.why_ko)}</div></div>`).join('')}</div>`:''}
    ${r.expressions.length ? `<div class="card exp"><div class="h">🧲 훔쳐갈 표현 (다음 통화 때 상대가 다시 써줘요)</div>${r.expressions.map(x=>`
      <div><b>${esc(x.en)}</b> <span>— ${esc(x.ko)}</span><small>${esc(x.example)}</small></div>`).join('')}</div>`:''}
    ${r.mission_ko ? `<div class="card"><div class="h">🎯 다음 통화 미션</div><div class="topic">${esc(r.mission_ko)}</div></div>`:''}
    ${txBlock(rec)}
    <button class="btn pri" onclick="go('home')">홈으로</button>`;
}
function txBlock(rec, open){
  return `<div class="card"><details ${open?'open':''}><summary>📜 대화 전문 보기</summary><div class="tx">${rec.transcript.map(t=>`<p><b style="color:${t.role==='user'?'var(--accent2)':'var(--ink)'}">${t.role==='user'?'나':esc(rec.partnerName)}:</b> ${esc(t.text)}</p>`).join('')}</div></details></div>`;
}
function retryReport(id){ const rec = S.history.find(h=>h.id===id); if(rec) showReport(rec, true); }

/* ---------- 기록 ---------- */
function renderHistory(){
  const list = $('histList');
  const items = [...S.history].reverse();
  if(!items.length){ list.innerHTML = '<div class="note">아직 통화 기록이 없어요. 첫 통화를 걸어보세요 📞</div>'; return; }
  const pname = id => id==='both' ? '💑 같이' : (S.profiles.find(p=>p.id===id)?.name || '?');
  list.innerHTML = items.map(h=>`<button class="hist" onclick='showReport(S.history.find(x=>x.id==="${h.id}"))'>
    <div><b>${esc(h.partnerName)}</b> · ${esc(pname(h.profileId))}<br><small>${esc(h.day)} · ${Math.round(h.secs/60)}분 · ${esc(h.topic||'')}</small></div>
    <div>${h.report ? '📄' : '⏳'}</div></button>`).join('');
}

/* ---------- base64 ---------- */
function b64(buf){ const u = new Uint8Array(buf); let s=''; for(let i=0;i<u.length;i+=0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i+0x8000)); return btoa(s); }

renderHome();
</script>
