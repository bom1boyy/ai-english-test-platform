      {id:'diego', em:'🌮', name:'Diego', voice:'Charon', tag:'멕시코시티 · 34 · 요리사',
       bio:'34, from Mexico City. Runs a taco stand, huge football fan.', accent:'Mexican Spanish', humor:'warm, jokey, loves exaggeration'},
    ]},
  zh: {
    label: '🇨🇳 中文', name: 'Mandarin Chinese',
    fillers: '"嗯", "那个", "就是", "然后", "对对对", "哎呀"',
    partners: [
      {id:'xiaolin', em:'🥟', name:'Xiaolin', voice:'Kore', tag:'상하이 · 27 · 마케터',
