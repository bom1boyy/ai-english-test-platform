const ROLEPLAYS = [
  {ko:'☕ 카페 주문', en:'You are a friendly, chatty barista at a busy café. The learner is ordering. Ask size, milk, name for the cup, try to upsell a pastry, and mishear their name once (funny).'},
  {ko:'🏨 호텔 체크인 문제', en:'You are a front-desk clerk. Their reservation shows the wrong date. Work it out together realistically.'},
