const str = (v, n) => (typeof v === 'string' ? v : '').slice(0, n);
const ID_RE = /^[a-z0-9]{6,20}$/;
function sanitizeProfile(p, i){
  return { id: ['p1','p2','p3'].includes(p?.id) ? p.id : 'p' + (i + 1),
           name: str(p?.name, 20).trim() || '나', level: LEVELS[p?.level] ? p.level : 'intermediate',
           interests: str(p?.interests, 120) };
}
function sanitizeRecord(h){
  if(!h || typeof h !== 'object' || !ID_RE.test(String(h.id))) return null;
  return {
    id:h.id, ts:Number(h.ts)||0, day:str(h.day,10), profileId:str(h.profileId,8), lang:LANGS[h.lang]?h.lang:'en',
    partnerId:str(h.partnerId,20), partnerName:str(h.partnerName,30), mode:str(h.mode,10), topic:str(h.topic,200),
    secs:Math.max(0, Math.min(7200, Number(h.secs)||0)), sessionId:str(h.sessionId,40),
    transcript:(Array.isArray(h.transcript)?h.transcript:[]).slice(0,400).map(t=>({role:t?.role==='user'?'user':'ai', text:str(t?.text,4000)})),
    report:h.report && typeof h.report === 'object' ? h.report : null,
  };
}
function sanitizeState(o){
  const d = structuredClone(DEFAULT);
  if(!o || typeof o !== 'object') return d;
  d.lang = LANGS[o.lang] ? o.lang : 'en';
  d.liveModel = LIVE_MODEL_LABELS[o.liveModel] ? o.liveModel : d.liveModel;
  d.textModel = /^gemini-[a-z0-9.\-]{1,60}$/.test(o.textModel||'') ? o.textModel : d.textModel;
  d.vad = VAD[o.vad] ? o.vad : 'normal';
  if(Array.isArray(o.profiles) && o.profiles.length) d.profiles = o.profiles.slice(0,2).map(sanitizeProfile);
  const s = o.sel || {};
  d.sel = { profile: ['p1','p2','both'].includes(s.profile) ? s.profile : 'p1', partner: str(s.partner,20) || 'jamie',
            mode: ['free','topic','role'].includes(s.mode) ? s.mode : 'topic', role: Math.max(0, Math.min(ROLEPLAYS.length-1, Number(s.role)||0)),
            dur: ALL_DURATIONS.includes(Number(s.dur)) ? Number(s.dur) : 5, caps: s.caps === '1' ? '1' : '0', topicShift: Number(s.topicShift)||0 };
  d.history = (Array.isArray(o.history)?o.history:[]).map(sanitizeRecord).filter(Boolean).slice(-200);
  d.updatedAt = Number(o.updatedAt)||0;
  d.owner = typeof o.owner === 'string' ? o.owner : null;
  return d;
}

