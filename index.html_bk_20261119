function streak(){
  const ids = isCouple() ? S.profiles.map(p=>p.id).concat('both') : [S.sel.profile, 'both'];
  const days = new Set(S.history.filter(h=>ids.includes(h.profileId)).map(h=>h.day));
  let n=0, d=new Date(); const today = days.has(dayKey(d));
  if(!today) d = new Date(Date.now()-86400000);
  while(days.has(dayKey(d))){ n++; d = new Date(d.getTime()-86400000); }
  return {n, today, days};
}

