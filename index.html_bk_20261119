<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src https://cdn.jsdelivr.net data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src https://bhwmxanakzrkqtdghyvo.supabase.co wss://bhwmxanakzrkqtdghyvo.supabase.co https://generativelanguage.googleapis.com wss://generativelanguage.googleapis.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#14121f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Ringo — 매일 10분, 진짜 사람 같은 영어 통화</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
:root{
  --bg:#14121f; --panel:#1e1b2e; --panel2:#272340; --line:#353052;
  --ink:#f4f1ff; --mute:#a59fc4; --accent:#ff8a65; --accent2:#7ee0c3; --warn:#ffd166; --bad:#ff6b81;
  --r:18px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:Pretendard,-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;}
body{padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);min-height:100vh}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
input,select,textarea{font:inherit;color:var(--ink);background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;width:100%;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
label{display:block;font-size:13px;color:var(--mute);margin:14px 0 6px}
.wrap{max-width:520px;margin:0 auto;padding:18px 18px 110px}
.top{display:flex;align-items:center;justify-content:space-between;margin:4px 0 18px}
.logo{font-weight:800;font-size:24px;letter-spacing:-.5px}
.logo span{color:var(--accent)}
.iconbtn{width:42px;height:42px;border-radius:14px;background:var(--panel);display:grid;place-items:center;font-size:19px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-bottom:14px}
.h{font-size:13px;color:var(--mute);font-weight:600;margin:0 0 10px;letter-spacing:.2px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:10px 14px;border-radius:999px;background:var(--panel2);border:1px solid var(--line);font-size:14px;font-weight:600}
.chip.on{background:var(--accent);border-color:var(--accent);color:#1b1022}
.streak{display:flex;align-items:center;gap:12px}
.streak .big{font-size:34px;font-weight:800}
.streak small{color:var(--mute)}
.dots{display:flex;gap:6px;margin-top:10px}
.dots i{width:100%;height:8px;border-radius:4px;background:var(--panel2);display:block}
.dots i.on{background:var(--accent2)}
.partners{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.pc{text-align:left;background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:12px}
.pc.on{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset}
.pc .em{font-size:26px}
.pc b{display:block;margin-top:4px}
.pc small{color:var(--mute);font-size:12px;line-height:1.35;display:block;margin-top:2px}
.topic{font-size:15px;line-height:1.5}
.topic .re{font-size:12px;color:var(--accent2);margin-top:8px;display:inline-block}
.row{display:flex;gap:10px}
.row>*{flex:1}
.callbtn{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(18px + env(safe-area-inset-bottom));width:min(484px,calc(100% - 36px));padding:18px;border-radius:20px;background:linear-gradient(135deg,#ff8a65,#ff5e7e);color:#1b1022;font-weight:800;font-size:18px;box-shadow:0 10px 30px rgba(255,110,110,.35)}
.callbtn:disabled{opacity:.5}
.note{font-size:12.5px;color:var(--mute);line-height:1.5}
.note a{color:var(--accent2)}
.screen{display:none}
.screen.on{display:block}
/* call screen */
#call{position:fixed;inset:0;background:radial-gradient(120% 80% at 50% 0%,#2b2450 0%,#14121f 60%);padding:calc(env(safe-area-inset-top) + 24px) 20px calc(env(safe-area-inset-bottom) + 24px);flex-direction:column;align-items:center}
#call.on{display:flex}
.who{text-align:center;margin-top:8px}
.who .nm{font-size:28px;font-weight:800}
.who .sub{color:var(--mute);font-size:14px;margin-top:4px}
.timer{font-variant-numeric:tabular-nums;color:var(--mute);margin-top:6px;font-size:15px}
.orbwrap{flex:1;display:grid;place-items:center;width:100%;min-height:200px}
.orb{width:170px;height:170px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffd0bf,#ff8a65 45%,#c2416b 100%);box-shadow:0 0 80px rgba(255,138,101,.45);transition:background .4s, box-shadow .4s;will-change:transform}
.orb.listen{background:radial-gradient(circle at 35% 30%,#d6fff2,#7ee0c3 45%,#2b8f7a 100%);box-shadow:0 0 80px rgba(126,224,195,.4)}
.orb.idle{background:radial-gradient(circle at 35% 30%,#e9e4ff,#8d84c4 45%,#3c3566 100%);box-shadow:0 0 50px rgba(141,132,196,.3)}
.state{margin-top:14px;color:var(--mute);font-size:14px;text-align:center;min-height:20px}
.caps{width:100%;max-width:520px;max-height:28vh;overflow:auto;font-size:14.5px;line-height:1.5;padding:0 4px;margin-bottom:14px;display:none}
.caps.on{display:block}
.caps p{margin:6px 0}
.caps .u{color:var(--accent2)}
.caps .a{color:var(--ink)}
.ctrls{display:flex;gap:14px;justify-content:center;align-items:center;width:100%;max-width:520px}
.cb{width:62px;height:62px;border-radius:50%;background:rgba(255,255,255,.08);display:grid;place-items:center;font-size:22px;position:relative}
.cb.on{background:var(--ink);color:#14121f}
.cb small{position:absolute;bottom:-20px;font-size:11px;color:var(--mute);white-space:nowrap}
.cb.hang{width:72px;height:72px;background:#ff4d6d;font-size:28px}
/* report */
.score{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;text-align:center}
.score div{background:var(--panel2);border-radius:12px;padding:10px 4px}
.score b{font-size:20px;display:block}
.score small{font-size:11px;color:var(--mute)}
.corr{padding:10px 0}
.corr+.corr{border-top:1px solid var(--line)}
.said{color:var(--bad);text-decoration:line-through;text-decoration-thickness:1px}
.better{color:var(--accent2);font-weight:700;margin-top:3px}
.why{color:var(--mute);font-size:13px;margin-top:3px}
.exp b{color:var(--warn)}
.exp div{margin-bottom:10px}
.exp small{color:var(--mute);display:block}
ul.k{margin:0;padding-left:18px;line-height:1.6}
.loading{text-align:center;padding:40px 0;color:var(--mute)}
.spin{width:34px;height:34px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--accent);animation:sp 1s linear infinite;margin:0 auto 14px}
@keyframes sp{to{transform:rotate(360deg)}}
.hist{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;text-align:left;border-top:1px solid var(--line);padding:12px 0}
.hist:first-of-type{border-top:0}
.hist small{color:var(--mute)}
.btn{padding:13px 16px;border-radius:14px;background:var(--panel2);border:1px solid var(--line);font-weight:700;width:100%}
.btn.pri{background:var(--accent);border-color:var(--accent);color:#1b1022}
.toast{position:fixed;left:50%;top:calc(env(safe-area-inset-top) + 16px);transform:translateX(-50%);background:var(--ink);color:#14121f;padding:10px 16px;border-radius:12px;font-weight:600;font-size:14px;z-index:99;display:none;max-width:90vw}
details summary{cursor:pointer;color:var(--mute);font-size:13px}
.tx{font-size:13.5px;line-height:1.55;max-height:300px;overflow:auto;margin-top:8px}
.tx p{margin:5px 0}
.syncchip{font-size:12px;font-weight:600;color:var(--mute);margin-left:6px;vertical-align:middle;letter-spacing:0}
.syncchip.ok{color:var(--accent2)}
.syncchip.err{color:var(--bad)}
.linkbtn{color:var(--mute);font-size:13px;text-decoration:underline;margin-top:14px;display:block;width:100%}
.pc.off{opacity:.45;position:relative}
.pc .lock,.lock{display:inline-block;margin-top:6px;font-size:11px;font-weight:700;color:var(--warn)}
.badge{display:inline-block;font-size:11px;font-weight:800;padding:3px 8px;border-radius:6px;background:var(--warn);color:#1b1022;letter-spacing:.5px}
.adminrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 0;border-top:1px solid var(--line)}
.adminrow:first-child{border-top:0}
.adminrow small{color:var(--mute)}
.abtns{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.mini{padding:7px 10px;border-radius:10px;background:var(--panel2);border:1px solid var(--line);font-size:12.5px;font-weight:700}
.mini.pri{background:var(--accent);border-color:var(--accent);color:#1b1022}
.mini.bad{color:var(--bad)}
.syncchip{font-size:12px;font-weight:600;color:var(--mute);margin-left:6px;vertical-align:middle;letter-spacing:0}
.syncchip.ok{color:var(--accent2)}
.syncchip.err{color:var(--bad)}
select option:disabled{color:#777}
.callbtn:disabled{background:var(--panel2);color:var(--mute);box-shadow:none}
</style>

</head>
<body>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<!-- LOADING -->
<section class="screen on" id="loading">
  <div class="wrap"><div class="loading"><div class="spin"></div>불러오는 중…</div></div>
</section>

<!-- AUTH -->
<section class="screen" id="auth">
  <div class="wrap">
    <div class="top"><div class="logo">Ring<span>o</span> 📞</div></div>
    <div class="card">
      <div class="h">☁️ 로그인하면 노트북·폰 어디서든 기억이 이어져요</div>
      <label style="margin-top:0" for="aEmail">이메일</label>
      <input id="aEmail" type="email" autocomplete="username" maxlength="120" placeholder="you@example.com">
      <label for="aPw">비밀번호 (8자 이상)</label>
      <input id="aPw" type="password" autocomplete="current-password" maxlength="72">
      <div style="height:14px"></div>
      <button class="btn pri" id="loginBtn">로그인</button>
      <div style="height:10px"></div>
      <button class="btn" id="signupBtn">처음이에요 — 가입 신청하기</button>
      <p class="note">가입하면 확인 메일이 가요. 메일 인증 후 관리자가 승인하면 사용할 수 있어요.</p>
    </div>
  </div>
</section>

<!-- PENDING / BLOCKED -->
<section class="screen" id="pending">
  <div class="wrap">
    <div class="top"><div class="logo">Ring<span>o</span> 📞</div></div>
    <div class="card">
      <div style="font-size:40px">⏳</div>
      <h2 id="pTitle" style="margin:8px 0">승인 대기 중이에요</h2>
      <p class="note" id="pBody">가입 신청이 접수됐어요. 관리자가 확인한 뒤 승인하면 바로 쓸 수 있어요.</p>
      <p class="note" id="pEmail"></p>
      <button class="btn pri" id="pRefresh">승인됐는지 확인하기</button>
      <div style="height:10px"></div>
      <button class="btn" data-act="logout">로그아웃</button>
    </div>
  </div>
</section>

<!-- HOME -->
<section class="screen" id="home">
  <div class="wrap">
    <div class="top">
      <div class="logo">Ring<span>o</span> 📞<span class="syncchip" id="syncChip"></span></div>
      <div class="row" style="flex:0;gap:8px">
        <button class="iconbtn" id="adminBtn" title="사용자 관리" style="display:none">👥</button>
        <button class="iconbtn" data-go="history" title="기록">🗂️</button>
        <button class="iconbtn" data-go="settings" title="설정">⚙️</button>
      </div>
    </div>

    <div class="card" id="testerCard" style="display:none">
      <div class="row" style="align-items:center">
        <div><span class="badge">TESTER</span> <b id="usageText">오늘 무료 통화 0/3</b></div>
      </div>
      <p class="note" id="usageNote" style="margin:8px 0 0">테스터는 Jamie와 영어로, 한 번에 최대 5분까지 무료로 통화할 수 있어요.</p>
    </div>

    <div class="card" id="profileCard">
      <div class="h">누가 통화하나요?</div>
      <div class="chips" id="profileChips"></div>
    </div>

    <div class="card">
      <div class="streak">
        <div class="big" id="streakNum">0</div>
        <div><b>일 연속 통화 🔥</b><br><small id="streakSub">오늘 첫 통화를 해볼까요?</small></div>
      </div>
      <div class="dots" id="weekDots"></div>
    </div>

    <div class="card">
      <div class="h">통화 상대</div>
      <div class="partners" id="partnerGrid"></div>
    </div>

    <div class="card">
      <div class="h">오늘은 뭐 할까요?</div>
      <div class="chips" id="modeChips"></div>
      <div id="modeExtra" style="margin-top:12px"></div>
    </div>

    <div class="card">
      <div class="row">
        <div><label style="margin-top:0" for="durSel">통화 시간</label><select id="durSel"></select></div>
        <div><label style="margin-top:0" for="capSel">자막</label>
          <select id="capSel"><option value="0">끄기 (진짜 전화처럼)</option><option value="1">켜기</option></select></div>
      </div>
      <p class="note" style="margin:12px 0 0">💡 이어폰을 쓰면 훨씬 자연스러워요. 상대가 말하는 중에 그냥 말을 끊어도 됩니다.</p>
    </div>
  </div>
  <button class="callbtn" id="callBtn">📞 전화 걸기</button>
</section>

<!-- CALL -->
<section class="screen" id="call">
  <div class="who">
    <div class="nm" id="cName">Jamie</div>
    <div class="sub" id="cSub">연결 중…</div>
    <div class="timer" id="cTimer">00:00</div>
  </div>
  <div class="orbwrap"><div>
    <div class="orb idle" id="orb"></div>
    <div class="state" id="cState">전화 거는 중…</div>
  </div></div>
  <div class="caps" id="caps"></div>
  <div class="ctrls">
    <button class="cb" id="muteBtn">🎙️<small>음소거</small></button>
    <button class="cb" id="sosBtn">🆘<small>막혔어요</small></button>
    <button class="cb hang" id="hangBtn" aria-label="통화 종료">✕</button>
    <button class="cb" id="slowBtn">🐢<small>천천히</small></button>
    <button class="cb" id="capBtn">💬<small>자막</small></button>
  </div>
  <div style="height:24px"></div>
</section>

<!-- REPORT -->
<section class="screen" id="report">
  <div class="wrap">
    <div class="top"><div class="logo">통화 리포트</div><button class="iconbtn" data-go="home">🏠</button></div>
    <div id="reportBody"></div>
  </div>
</section>

<!-- HISTORY -->
<section class="screen" id="history">
  <div class="wrap">
    <div class="top"><div class="logo">통화 기록</div><button class="iconbtn" data-go="home">🏠</button></div>
    <div class="card" id="histList"></div>
  </div>
</section>

<!-- ADMIN -->
<section class="screen" id="admin">
  <div class="wrap">
    <div class="top"><div class="logo">사용자 관리</div><button class="iconbtn" data-go="home">🏠</button></div>
    <div class="card" id="adminList"><div class="loading"><div class="spin"></div></div></div>
    <p class="note">승인 = 테스터(영어·Jamie·최대 5분·하루 3회). 마스터 지정/해제는 보안상 SQL에서만 할 수 있어요.</p>
  </div>
</section>

<!-- SETTINGS -->
<section class="screen" id="settings">
  <div class="wrap">
    <div class="top"><div class="logo">설정</div><button class="iconbtn" id="saveTop">✅</button></div>
    <div class="card">
      <div class="h">계정</div>
      <div class="note" id="acctInfo"></div>
      <div style="height:10px"></div>
      <button class="btn" id="syncBtn">지금 동기화</button>
      <div style="height:8px"></div>
      <button class="btn" data-act="logout">로그아웃</button>
    </div>
    <div class="card">
      <div class="h">배울 언어</div>
      <select id="sLang"></select>
    </div>
    <div class="card">
      <div class="h">프로필</div>
      <div id="sProfiles"></div>
    </div>
    <div class="card">
      <div class="h">대화 호흡</div>
      <label style="margin-top:0" for="sVad">상대가 끼어드는 타이밍</label>
      <select id="sVad">
        <option value="relaxed">여유롭게 — 내가 생각할 시간을 길게 줘</option>
        <option value="normal">보통 — 친구랑 통화하듯</option>
        <option value="snappy">빠르게 — 잠깐만 멈춰도 바로 치고 들어와</option>
      </select>
    </div>
    <div class="card" id="advCard" style="display:none">
      <details>
        <summary>고급 설정 (모델) · 마스터 전용</summary>
        <label for="sLive">실시간 음성 모델</label>
        <select id="sLive"></select>
        <label for="sText">피드백 리포트 모델</label>
        <input id="sText" placeholder="gemini-flash-latest" maxlength="64">
      </details>
    </div>
    <button class="btn pri" id="saveBtn">저장</button>
    <div style="height:10px"></div>
    <button class="btn" id="exportBtn">기록 백업 복사하기 (JSON)</button>
    <div style="height:10px"></div>
    <details class="card"><summary>예전 기록 가져오기 (백업 붙여넣기)</summary>
      <textarea id="importTxt" rows="5" maxlength="2000000" placeholder="이전 버전에서 복사한 백업 JSON을 붙여넣으세요" style="margin-top:10px"></textarea>
      <div style="height:10px"></div>
      <button class="btn" id="importBtn">가져오기</button>
    </details>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.119.1/dist/umd/supabase.js" integrity="sha384-2DeuFKyqIlpZfFmj+jl/+IbM3DwDM4vGKsvK0fI32E0ZDt24W33hB6pka4RAdbz2" crossorigin="anonymous"></script>
<script>
'use strict';
/* =========================================================
   Ringo — 사람 같은 외국어 통화 연습
   - Gemini 키는 서버(Supabase Edge Function)에만 있음. 브라우저는 통화 1회용 임시 토큰만 받음.
   - 역할: master(부부) / tester / pending / blocked — 제한은 서버가 강제, 화면은 안내용.
   ========================================================= */
if (window.top !== window.self) { document.documentElement.style.display = 'none'; try { window.top.location = window.self.location; } catch (e) {} }

const SUPABASE_URL = 'https://bhwmxanakzrkqtdghyvo.supabase.co';
const SUPABASE_KEY = 'sb_publishable_Wkdr6hBOZskHqiu2mFsigQ_Y-bU_qiC';   // publishable key (공개돼도 되는 키 — 데이터는 RLS로 보호)
const API_URL = SUPABASE_URL + '/functions/v1/ringo-api';
const WS_URL = 'wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained';
const ALL_DURATIONS = [1, 3, 5, 10, 15, 20, 30, 60];
const LIVE_MODEL_LABELS = {
  'gemini-3.1-flash-live-preview': 'gemini-3.1-flash-live-preview (최신, 추천)',
  'gemini-2.5-flash-native-audio-preview-12-2025': 'gemini-2.5-flash-native-audio-preview-12-2025',
};

const LANGS = {
  en: {
    label: '🇺🇸 English', name: 'English',
