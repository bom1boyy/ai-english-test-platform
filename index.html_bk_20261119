let C = null;

async function startCall(){
  if(!ME || !['tester','master'].includes(ME.role)){ toast('승인된 계정만 통화할 수 있어요'); return; }
  enforceLimits();
  const L = lim();
  if(L.dailyMax !== null && (L.dailyUsed||0) >= L.dailyMax){ toast(ERR_KO.daily_limit, 4000); return; }
  if(!navigator.mediaDevices?.getUserMedia){ toast('이 브라우저는 마이크를 지원하지 않아요 (https 주소로 열어주세요)'); return; }
  const P = partner();
  C = { ws:null, ctx:null, stream:null, node:null, src:null, inAn:null, outAn:null, sources:new Set(), nextTime:0,
        ready:false, closing:false, muted:false, handle:null, reconnects:0, greeted:false, token:null, setup:null, sessionId:null,
        transcript:[], start:0, timerId:0, wrapSent:false, raf:0, wake:null, durSec:S.sel.dur*60, capsOn:S.sel.caps==='1' };
  $('cName').textContent = P.name; $('cSub').textContent = P.tag; $('cTimer').textContent='00:00';
  $('caps').textContent=''; $('caps').classList.toggle('on', C.capsOn); $('capBtn').classList.toggle('on', C.capsOn);
  $('muteBtn').classList.remove('on'); setState('idle','전화 거는 중… 📞');
  go('call');
  try{
    C.ctx = new (window.AudioContext||window.webkitAudioContext)();
    const resumeP = C.ctx.resume();
    C.stream = await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true, noiseSuppression:true, autoGainControl:true, channelCount:1}});
    await resumeP;
    await setupMic();
    C.outAn = C.ctx.createAnalyser(); C.outAn.fftSize = 512; C.outAn.connect(C.ctx.destination);
    try{ C.wake = await navigator.wakeLock?.request('screen'); }catch(e){}
    const t = await api('token', { lang:S.lang, partner:P.id, minutes:S.sel.dur, model:S.liveModel, vad:S.vad, system:buildSystem() });
    if(!C) return;
    C.token = t.token; C.setup = t.setup; C.sessionId = t.sessionId; C.durSec = t.minutes*60;
    ME.limits.dailyUsed = t.dailyUsed;
    openSocket(null);
    animate();
  }catch(e){
    console.warn(e);
    toast(e?.name==='NotAllowedError' ? '마이크 권한이 필요해요' : errMsg(e), 4500);
    cleanup(); C = null; go('home');
  }
}

async function setupMic(){
  const code = `
  class Cap extends AudioWorkletProcessor{
    constructor(){ super(); this.ratio = sampleRate/16000; this.pos=0; this.sum=0; this.cnt=0; this.out=new Int16Array(1600); this.n=0; }
    process(inputs){
      const ch = inputs[0] && inputs[0][0]; if(!ch) return true;
      for(let i=0;i<ch.length;i++){
        this.sum += ch[i]; this.cnt++; this.pos += 1;
        if(this.pos >= this.ratio){
          this.pos -= this.ratio;
          let v = this.sum/this.cnt; this.sum=0; this.cnt=0;
          v = Math.max(-1, Math.min(1, v));
          this.out[this.n++] = v<0 ? v*0x8000 : v*0x7fff;
          if(this.n === this.out.length){ this.port.postMessage(this.out.buffer.slice(0)); this.n=0; }
        }
      }
      return true;
    }
  }
  registerProcessor('ringo-cap', Cap);`;
  C.src = C.ctx.createMediaStreamSource(C.stream);
  C.inAn = C.ctx.createAnalyser(); C.inAn.fftSize = 512;
  C.src.connect(C.inAn);
  const g = C.ctx.createGain(); g.gain.value = 0; g.connect(C.ctx.destination);
  const send = buf => {
    if(!C || !C.ready || C.muted || C.ws?.readyState!==1) return;
    C.ws.send(JSON.stringify({realtimeInput:{audio:{data:b64(buf), mimeType:'audio/pcm;rate=16000'}}}));
  };
  try{
    if(!C.ctx.audioWorklet) throw new Error('no worklet');
    const url = URL.createObjectURL(new Blob([code], {type:'application/javascript'}));
    await C.ctx.audioWorklet.addModule(url); URL.revokeObjectURL(url);
    C.node = new AudioWorkletNode(C.ctx, 'ringo-cap');
    C.node.port.onmessage = e => send(e.data);
  }catch(err){
    const ratio = C.ctx.sampleRate/16000; let pos=0, sum=0, cnt=0, n=0; const out=new Int16Array(1600);
    C.node = C.ctx.createScriptProcessor(4096, 1, 1);
    C.node.onaudioprocess = e => {
      const ch = e.inputBuffer.getChannelData(0);
      for(let i=0;i<ch.length;i++){
        sum += ch[i]; cnt++; pos += 1;
        if(pos >= ratio){ pos -= ratio; const v = Math.max(-1, Math.min(1, sum/cnt)); sum=0; cnt=0;
          out[n++] = v<0 ? v*0x8000 : v*0x7fff;
          if(n === out.length){ send(out.buffer.slice(0)); n=0; } }
      }
    };
  }
  C.src.connect(C.node); C.node.connect(g);
}

function openSocket(handle){
  const ws = new WebSocket(`${WS_URL}?access_token=${encodeURIComponent(C.token)}`);
  ws.binaryType = 'arraybuffer';
  C.ws = ws; C.ready = false;
  ws.onopen = () => {
    const setup = JSON.parse(JSON.stringify(C.setup));
    setup.sessionResumption = handle ? { handle } : {};
    ws.send(JSON.stringify({ setup }));
  };
  ws.onmessage = ev => {
    const txt = typeof ev.data === 'string' ? ev.data : new TextDecoder().decode(ev.data);
    let m; try{ m = JSON.parse(txt); }catch(e){ return; }
    onServer(m);
  };
  ws.onclose = e => {
    if(!C || ws !== C.ws || C.closing) return;
    const elapsed = C.start ? (Date.now()-C.start)/1000 : 0;
    if(elapsed >= C.durSec - 5){ hangUp(); return; }            // 서버가 정한 통화 시간 종료
    if(C.handle && C.reconnects < 3 && C.greeted){ C.reconnects++; setState('idle','잠깐 신호가 끊겼어요… 다시 연결 중'); openSocket(C.handle); return; }
    toast('연결이 끊겼어요' + (e.reason ? ': ' + e.reason.slice(0,120) : ''), 6000);
    hangUp(true);
  };
}
function reconnect(){ if(!C || !C.handle) return; const old = C.ws; C.ws = null; try{ old.onclose = null; old.close(); }catch(e){} openSocket(C.handle); }

function onServer(m){
  if(!C) return;
  if(m.setupComplete){
    C.ready = true;
    if(!C.greeted){
      C.greeted = true; C.start = Date.now(); C.timerId = setInterval(tick, 500);
      $('cSub').textContent = '통화 중'; setState('speak','');
      sendText('(App note: the call just connected. Say hello now.)');
    } else setState('listen','다시 연결됐어요');
    return;
  }
  if(m.sessionResumptionUpdate?.resumable && typeof m.sessionResumptionUpdate.newHandle === 'string') C.handle = m.sessionResumptionUpdate.newHandle;
  if(m.goAway){ reconnect(); return; }
  const sc = m.serverContent; if(!sc) return;
  if(sc.interrupted) flushAudio();
  if(Array.isArray(sc.modelTurn?.parts)){
    for(const p of sc.modelTurn.parts){
      if(typeof p.inlineData?.data === 'string' && String(p.inlineData.mimeType||'').startsWith('audio')) playPCM(p.inlineData.data, p.inlineData.mimeType);
    }
  }
  if(typeof sc.inputTranscription?.text === 'string') addCap('user', sc.inputTranscription.text);
  if(typeof sc.outputTranscription?.text === 'string') addCap('ai', sc.outputTranscription.text);
}
function sendText(t){ if(C?.ws?.readyState===1) C.ws.send(JSON.stringify({realtimeInput:{text:t}})); }

function playPCM(data, mime){
  const rate = Math.min(48000, Math.max(8000, +(/rate=(\d+)/.exec(mime||'')?.[1] || 24000)));
  let bin; try{ bin = atob(data); }catch(e){ return; }
  const len = bin.length >> 1; if(!len) return;
  const f = new Float32Array(len);
  for(let i=0;i<len;i++){ let s = bin.charCodeAt(2*i) | (bin.charCodeAt(2*i+1)<<8); if(s>=0x8000) s -= 0x10000; f[i] = s/32768; }
  const buf = C.ctx.createBuffer(1, len, rate); buf.copyToChannel(f, 0);
  const src = C.ctx.createBufferSource(); src.buffer = buf; src.connect(C.outAn);
  const t = Math.max(C.ctx.currentTime + 0.03, C.nextTime);
  src.start(t); C.nextTime = t + buf.duration;
  C.sources.add(src); src.onended = () => C?.sources.delete(src);
}
function flushAudio(){ if(!C) return; C.sources.forEach(s=>{ try{s.stop();}catch(e){} }); C.sources.clear(); C.nextTime = 0; }
function aiSpeaking(){ return C && C.ctx && C.nextTime > C.ctx.currentTime + 0.01; }

function addCap(role, text){
  const T = C.transcript; let last = T[T.length-1];
  if(!last || last.role !== role){ if(T.length >= 400) return; last = {role, text:''}; T.push(last); }
  if(last.text.length < 4000) last.text += text;
  if(C.capsOn) renderCaps();
}
function renderCaps(){
  const P = partner(); const me = isCouple() ? '우리' : learners()[0].name;
  $('caps').innerHTML = C.transcript.slice(-8).map(t=>`<p class="${t.role==='user'?'u':'a'}"><b>${t.role==='user'?esc(me):esc(P.name)}:</b> ${esc(t.text.trim())}</p>`).join('');
  $('caps').scrollTop = 1e9;
}
function toggleCaps(){ C.capsOn = !C.capsOn; $('caps').classList.toggle('on', C.capsOn); $('capBtn').classList.toggle('on', C.capsOn); if(C.capsOn) renderCaps(); }
function toggleMute(){
  C.muted = !C.muted; $('muteBtn').classList.toggle('on', C.muted);
  if(C.muted && C.ws?.readyState===1) C.ws.send(JSON.stringify({realtimeInput:{audioStreamEnd:true}}));
  toast(C.muted ? '음소거 🔇' : '음소거 해제 🎙️', 1200);
}
function sos(){ sendText('(App note: the learner pressed the "I\'m stuck" button. In a natural, friendly way, help them out: suggest one or two simple phrases they could say right now, then hand the turn back to them.)'); toast('도움 요청했어요 🆘', 1200); }
function slower(){ sendText('(App note: the learner asked you to speak a bit slower and with simpler words for a while. Do it naturally, without mentioning it much.)'); toast('천천히 말해달라고 했어요 🐢', 1200); }
function setState(kind, text){ const o=$('orb'); o.className = 'orb ' + (kind==='speak'?'':kind); if(text!=null) $('cState').textContent = text; }

function tick(){
  if(!C) return;
  const s = Math.floor((Date.now()-C.start)/1000), D = C.durSec;
  $('cTimer').textContent = `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')} / ${Math.round(D/60)}:00`;
  const wrapAt = D - Math.min(40, Math.round(D*0.25));
  if(!C.wrapSent && s >= wrapAt){ C.wrapSent = true; sendText('(App note: the call is almost over. Start wrapping up naturally and say goodbye within your next turn or two — maybe mention something to talk about next time.)'); }
  if(s >= D + 30 && !aiSpeaking()) hangUp();
}
function animate(){
  const a = new Uint8Array(256);
  const loop = () => {
    if(!C) return;
    let lvl = 0;
    if(aiSpeaking() && C.outAn){ C.outAn.getByteTimeDomainData(a); lvl = rms(a); if(C.ready) setState('speak', '말하는 중…'); }
    else if(C.inAn && C.ready){ C.inAn.getByteTimeDomainData(a); lvl = C.muted ? 0 : rms(a); setState('listen', C.muted ? '음소거됨' : '듣고 있어요 — 편하게 말하세요'); }
    $('orb').style.transform = `scale(${1 + Math.min(lvl*4, .45)})`;
    C.raf = requestAnimationFrame(loop);
  };
  loop();
}
function rms(a){ let s=0; for(let i=0;i<a.length;i++){ const v=(a[i]-128)/128; s+=v*v; } return Math.sqrt(s/a.length); }
function cleanup(){
  if(!C) return;
  C.closing = true;
  clearInterval(C.timerId); cancelAnimationFrame(C.raf);
  try{ C.ws && C.ws.close(); }catch(e){}
  flushAudio();
  try{ C.stream?.getTracks().forEach(t=>t.stop()); }catch(e){}
  try{ C.ctx?.close(); }catch(e){}
  try{ C.wake?.release(); }catch(e){}
  C.token = null;
}
function hangUp(failed){
  if(!C || C.closing) return;
  const call = C; cleanup(); C = null;
  renderHome();
  const secs = call.start ? Math.floor((Date.now()-call.start)/1000) : 0;
  const userChars = call.transcript.filter(t=>t.role==='user').reduce((n,t)=>n+t.text.trim().length, 0);
  if(secs < 20 || userChars < 15){ if(!failed) toast('통화가 너무 짧아서 리포트는 건너뛸게요'); go('home'); return; }
  const P = partner();
  const rec = sanitizeRecord({ id: Date.now().toString(36), day: dayKey(), ts: Date.now(), profileId: S.sel.profile, lang: S.lang,
    partnerId: P.id, partnerName: P.name, mode: S.sel.mode, sessionId: call.sessionId,
    topic: S.sel.mode==='topic' ? todayTopic() : S.sel.mode==='role' ? ROLEPLAYS[S.sel.role]?.ko : '자유 수다',
    secs, transcript: call.transcript.map(t=>({role:t.role, text:t.text.trim()})), report:null });
  S.history.push(rec); S.history = S.history.slice(-200); save(); cloudPutCall(rec);
  showReport(rec, true);
}

/* ---------- 리포트 (서버가 만듦) ---------- */
async function makeReport(rec){
  const both = rec.profileId==='both';
  const prof = S.profiles.find(p=>p.id===rec.profileId);
  const r = await api('report', { sessionId: rec.sessionId, transcript: rec.transcript,
    names: both ? S.profiles.map(p=>p.name).join(' & ') : (prof?.name || 'learner'),
    level: both ? 'mixed' : (prof?.level || 'intermediate'), textModel: isMaster() ? S.textModel : undefined });
  return r.report;
}
async function showReport(rec, generate){
  if(!rec) return;
  go('report');
  const body = $('reportBody');
  if(generate || !rec.report){
    body.innerHTML = `<div class="loading"><div class="spin"></div>${esc(rec.partnerName)}랑 나눈 대화를 정리하는 중…</div>`;
    try{
      const rep = await makeReport(rec);
      rec.report = rep; const i = S.history.findIndex(h=>h.id===rec.id); if(i>=0) S.history[i] = rec; save(); cloudPutCall(rec);
    }catch(e){
      body.innerHTML = `<div class="card"><b>리포트를 만들지 못했어요</b><p class="note">${esc(errMsg(e))}</p><button class="btn" data-retry="${esc(rec.id)}">다시 시도</button></div>` + txBlock(rec, true);
      return;
    }
  }
  const r = rec.report, sc = r.scores || {};
  const m = Math.floor(rec.secs/60), s = rec.secs%60;
  const arr = v => Array.isArray(v) ? v : [];
  body.innerHTML = `
    <div class="card">
      <div class="h">${esc(rec.day)} · ${esc(rec.partnerName)} · ${m}분 ${s}초 · ${esc(rec.topic||'')}</div>
      <div style="font-size:17px;font-weight:700;line-height:1.45;margin-bottom:8px">${rich(r.fun_ko)}</div>
      <div class="topic">${rich(r.summary_ko)}</div>
    </div>
    <div class="card"><div class="score">
      ${[['fluency','유창성'],['vocabulary','어휘'],['grammar','문법'],['confidence','자신감']].map(([k,l])=>`<div><b>${esc(sc[k]??'-')}</b><small>${l}</small></div>`).join('')}
    </div></div>
    ${arr(r.good_ko).length ? `<div class="card"><div class="h">👏 잘한 점</div><ul class="k">${arr(r.good_ko).map(x=>`<li>${rich(x)}</li>`).join('')}</ul></div>`:''}
    ${arr(r.corrections).length ? `<div class="card"><div class="h">✏️ 이렇게 말하면 더 자연스러워요</div>${arr(r.corrections).map(c=>`
      <div class="corr"><div class="said">${esc(c?.said)}</div><div class="better">→ ${esc(c?.better)}</div><div class="why">${rich(c?.why_ko)}</div></div>`).join('')}</div>`:''}
    ${arr(r.expressions).length ? `<div class="card exp"><div class="h">🧲 훔쳐갈 표현 (다음 통화 때 상대가 다시 써줘요)</div>${arr(r.expressions).map(x=>`
      <div><b>${esc(x?.en)}</b> <span>— ${esc(x?.ko)}</span><small>${esc(x?.example)}</small></div>`).join('')}</div>`:''}
    ${r.mission_ko ? `<div class="card"><div class="h">🎯 다음 통화 미션</div><div class="topic">${rich(r.mission_ko)}</div></div>`:''}
    ${txBlock(rec)}
    <button class="btn pri" data-go="home">홈으로</button>`;
}
function txBlock(rec, open){
  return `<div class="card"><details ${open?'open':''}><summary>📜 대화 전문 보기</summary><div class="tx">${rec.transcript.map(t=>`<p><b style="color:${t.role==='user'?'var(--accent2)':'var(--ink)'}">${t.role==='user'?'나':esc(rec.partnerName)}:</b> ${esc(t.text)}</p>`).join('')}</div></details></div>`;
}
$('reportBody').addEventListener('click', e=>{
  const b = e.target.closest('button[data-retry]'); if(!b) return;
  const rec = S.history.find(h=>h.id===b.dataset.retry); if(rec) showReport(rec, true);
});

/* ---------- 기록 ---------- */
function renderHistory(){
  const list = $('histList');
  const items = [...S.history].reverse();
  if(!items.length){ list.innerHTML = '<div class="note">아직 통화 기록이 없어요. 첫 통화를 걸어보세요 📞</div>'; return; }
  const pname = id => id==='both' ? '💑 같이' : (S.profiles.find(p=>p.id===id)?.name || '나');
  list.innerHTML = items.map(h=>`<button class="hist" data-id="${esc(h.id)}">
    <div><b>${esc(h.partnerName)}</b> · ${esc(pname(h.profileId))}<br><small>${esc(h.day)} · ${Math.round(h.secs/60)}분 · ${esc(h.topic||'')}</small></div>
    <div>${h.report ? '📄' : '⏳'}</div></button>`).join('');
}
$('histList').addEventListener('click', e=>{
  const b = e.target.closest('button[data-id]'); if(!b) return;
  const rec = S.history.find(h=>h.id===b.dataset.id); if(rec) showReport(rec, false);
});

function b64(buf){ const u = new Uint8Array(buf); let s=''; for(let i=0;i<u.length;i+=0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i+0x8000)); return btoa(s); }

/* =========================================================
   ☁️ 로그인 · 동기화
   ========================================================= */
function setSync(state){
  const el = $('syncChip'); if(!el) return;
  el.textContent = {syncing:'· ☁️ 동기화 중…', ok:'· ☁️ 동기화됨', err:'· ⚠️ 동기화 실패'}[state] || '';
  el.className = 'syncchip ' + (state==='ok' ? 'ok' : state==='err' ? 'err' : '');
}
function settingsPayload(){ const o = {...S}; delete o.history; delete o.owner; return o; }
function queueSettingsPush(){
  if(!sb || !user || pulling || !ME || !['tester','master'].includes(ME.role)) return;
  clearTimeout(pushTimer);
  pushTimer = setTimeout(async () => {
    const { error } = await sb.from('ringo_settings').upsert({ user_id:user.id, data:settingsPayload(), updated_at:new Date().toISOString() });
    setSync(error ? 'err' : 'ok'); if(error) console.warn(error);
  }, 800);
}
async function cloudPutCall(rec){
  if(!sb || !user || !rec || !ME || !['tester','master'].includes(ME.role)) return;
  const { error } = await sb.from('ringo_calls').upsert({ id:rec.id, user_id:user.id, ts:rec.ts, data:rec, updated_at:new Date().toISOString() });
  setSync(error ? 'err' : 'ok'); if(error) console.warn(error);
}
async function cloudPull(){
  pulling = true;
  try{
    const [st, cl] = await Promise.all([
      sb.from('ringo_settings').select('data').maybeSingle(),
      sb.from('ringo_calls').select('id,data').order('ts', {ascending:true}).limit(500),
    ]);
    if(st.error) throw st.error; if(cl.error) throw cl.error;
    const remote = st.data?.data ? sanitizeState(st.data.data) : null;
    const firstSync = S.owner !== user.id;
    let pushSettings = !remote;
    if(remote && (firstSync || remote.updatedAt >= S.updatedAt)){
      const hist = S.history; S = remote; S.history = hist;
    } else if(remote) pushSettings = true;
    const cloudById = new Map((cl.data||[]).map(r=>[r.id, sanitizeRecord(r.data)]).filter(([,d])=>d));
    const merged = new Map(S.history.map(h=>[h.id, h]));
    for(const [id, d] of cloudById){ const loc = merged.get(id); if(!loc || (!loc.report && d.report)) merged.set(id, d); }
    const toUpload = S.history.filter(h=>{ const c = cloudById.get(h.id); return !c || (h.report && !c.report); });
    S.history = [...merged.values()].sort((a,b)=>a.ts-b.ts).slice(-200);
    S.owner = user.id;
    if(!remote && !isMaster()){
      // 테스터 첫 로그인: 부부 프로필 대신 본인 프로필 하나
      const nick = str((user.email||'').split('@')[0], 12).replace(/[^\p{L}\p{N}._-]/gu, '') || '나';
      S.profiles = [{id:'p1', name:nick, level:'intermediate', interests:''}]; S.sel.profile = 'p1';
    }
    enforceLimits();
    localSave();
    pulling = false;
    for(const h of toUpload) await cloudPutCall(h);
    if(pushSettings) queueSettingsPush();
  } finally { pulling = false; }
}
async function syncNow(){
  try{ setSync('syncing'); await cloudPull(); setSync('ok'); if($('home').classList.contains('on')) renderHome(); }
  catch(e){ console.warn(e); setSync('err'); toast('동기화 실패: ' + (e.message||e), 5000); }
}
async function refreshMe(){
  ME = await api('me');
  if(ME.role === 'pending' || ME.role === 'blocked'){
    $('pTitle').textContent = ME.role==='blocked' ? '이용이 제한된 계정이에요' : '승인 대기 중이에요';
    $('pBody').textContent = ME.role==='blocked' ? '관리자에게 문의해 주세요.' : '가입 신청이 접수됐어요. 관리자가 확인한 뒤 승인하면 바로 쓸 수 있어요.';
    $('pEmail').textContent = user?.email || '';
    go('pending'); return false;
  }
  return true;
}
async function afterLogin(){
  if(S.owner && S.owner !== user.id){ S = structuredClone(DEFAULT); localSave(); }   // 다른 계정의 캐시는 버림
  try{
    if(!(await refreshMe())) return;
    await syncNow(); go('home');
  }catch(e){
    toast(errMsg(e), 5000);
    if(e.code==='invalid_session' || e.code==='no_session'){ await sb.auth.signOut(); go('auth'); } else go('auth');
  }
}
async function doLogin(signup){
  const email = $('aEmail').value.trim(), password = $('aPw').value;
  if(!/^[^\s@]{1,64}@[^\s@]{1,190}\.[^\s@]{2,}$/.test(email)){ toast('이메일을 확인해 주세요'); return; }
  if(password.length < 8){ toast('비밀번호는 8자 이상이에요'); return; }
  $('loginBtn').disabled = $('signupBtn').disabled = true;
  try{
    const res = signup
      ? await sb.auth.signUp({ email, password, options:{ emailRedirectTo: location.origin + location.pathname } })
      : await sb.auth.signInWithPassword({ email, password });
    if(res.error){ toast((signup ? '가입' : '로그인') + ' 실패: ' + (res.error.message === 'Invalid login credentials' ? '이메일 또는 비밀번호가 맞지 않아요' : res.error.message), 5000); return; }
    if(!res.data.session){ toast('확인 메일을 보냈어요. 메일의 링크를 누른 뒤 로그인해 주세요.', 8000); return; }
    user = res.data.user; $('aPw').value = '';
    await afterLogin();
  } finally { $('loginBtn').disabled = $('signupBtn').disabled = false; }
}
async function doLogout(){
  try{ if(sb) await sb.auth.signOut(); }catch(e){}
  user = null; ME = null; S = structuredClone(DEFAULT);
  try{ localStorage.removeItem(STORE_KEY); }catch(e){}
  setSync(''); go('auth'); toast('로그아웃했어요');
}

/* ---------- 이벤트 연결 (인라인 핸들러 최소화) ---------- */
document.addEventListener('click', e=>{
  const g = e.target.closest('[data-go]'); if(g){ go(g.dataset.go); return; }
  const a = e.target.closest('[data-act="logout"]'); if(a){ doLogout(); }
});
$('loginBtn').onclick = () => doLogin(false);
$('signupBtn').onclick = () => doLogin(true);
$('pRefresh').onclick = async () => { try{ if(await refreshMe()){ await syncNow(); go('home'); toast('승인됐어요! 🎉'); } else toast('아직 대기 중이에요'); }catch(e){ toast(errMsg(e)); } };
$('adminBtn').onclick = () => go('admin');
$('callBtn').onclick = startCall;
$('hangBtn').onclick = () => hangUp();
$('muteBtn').onclick = toggleMute; $('sosBtn').onclick = sos; $('slowBtn').onclick = slower; $('capBtn').onclick = toggleCaps;
$('saveBtn').onclick = saveSettings; $('saveTop').onclick = saveSettings;
$('exportBtn').onclick = exportData; $('importBtn').onclick = importData;
$('syncBtn').onclick = async () => { try{ await refreshMe(); }catch(e){} await syncNow(); renderSettings(); };
document.addEventListener('visibilitychange', () => { if(document.visibilityState==='visible' && user && !C && ME && ['tester','master'].includes(ME.role)) { refreshMe().then(ok=>ok && syncNow()).catch(()=>{}); } });

async function boot(){
  if(!window.supabase){ $('loading').innerHTML = '<div class="wrap"><div class="card">로그인 모듈을 불러오지 못했어요. 인터넷 연결을 확인하고 새로고침해 주세요.</div></div>'; return; }
  sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY, { auth:{ persistSession:true, autoRefreshToken:true, detectSessionInUrl:true, flowType:'pkce' } });
  const { data:{ session } } = await sb.auth.getSession();
  user = session?.user || null;
  sb.auth.onAuthStateChange((ev, s) => { user = s?.user || null; if(ev === 'SIGNED_OUT' && !$('auth').classList.contains('on')) go('auth'); });
  if(location.search.includes('code=')) history.replaceState(null, '', location.pathname);   // 인증 링크 흔적 제거
  if(!user){ go('auth'); return; }
  await afterLogin();
}
boot();
